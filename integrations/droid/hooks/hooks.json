{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${DROID_PLUGIN_ROOT}/hooks/echo-veil-preflight.sh\" prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${DROID_PLUGIN_ROOT}/hooks/echo-veil-preflight.sh\" agent"
          }
        ]
      }
    ]
  }
}
