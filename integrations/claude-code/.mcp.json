      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/../..",
        "--locked",
        "echo-veil-agent",
        "mcp"
      ],
      "env": {
        "ECHO_VEIL_PROFILE": "claude-code"
      }
    }
  }
}
