{
  "description": "Echo Veil memory preflight for Grok Build. Prompt delivery is unqualified; subagent PreToolUse returns a native deny decision.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo-veil-preflight-hook --host grok-build --hook-mode prompt",
            "timeout": 30,
            "statusMessage": "Loading Echo Veil context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "spawn_subagent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "echo-veil-preflight-hook --host grok-build --hook-mode agent",
            "timeout": 30,
            "statusMessage": "Checking Grok delegation"
          }
        ]
      }
    ]
  }
}
