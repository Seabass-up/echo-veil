{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "echo_veil": {
      "type": "local",
      "command": [
        "echo-veil-agent",
        "--profile",
        "opencode-qwen3",
        "--embedder",
        "ollama",
        "--embedding-model",
        "qwen3-embedding:latest",
        "--embedding-dimension",
        "1024",
        "mcp"
