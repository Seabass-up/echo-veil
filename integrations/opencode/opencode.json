{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "echo_veil": {
      "type": "local",
      "command": [
        "echo-veil-agent",
        "--profile",
        "echo-universal-qwen3-v1",
        "--scope",
        "local-user",
        "--caller",
        "opencode",
        "--embedder",
        "ollama",
        "--embedding-model",
        "qwen3-embedding:latest",
        "--embedding-dimension",
        "1024",
        "--availability-layer",
        "mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "echo-veil_echo_veil_remember": "ask",
    "echo-veil_echo_veil_refresh_live": "ask",
    "echo-veil_echo_veil_promote": "ask",
    "echo-veil_echo_veil_recall": "ask",
    "echo-veil_echo_veil_context": "ask",
    "echo-veil_echo_veil_forget": "ask",
    "echo-veil_echo_veil_reindex": "ask"
  }
}
