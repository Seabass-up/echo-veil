{
  "name": "pi-extension-echo-veil",
  "version": "0.8.0",
  "description": "Native Pi tools for Echo Veil's local agent memory adapter.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "memory",
    "privacy"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "1.3.15"
  },
  "peerDependenciesMeta": {
