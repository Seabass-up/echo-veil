{
  "name": "echo-veil-enclave-gateway",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/index.test.mjs",
    "render-config": "node scripts/render-config.mjs",
    "deploy": "npm run render-config && wrangler deploy --config .wrangler.generated.json",
    "deploy:dry-run": "npm run render-config && wrangler deploy --dry-run --config .wrangler.generated.json",
    "dev": "npm run render-config && wrangler dev --config .wrangler.generated.json"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260715.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
