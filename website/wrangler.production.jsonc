{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "echo-veil-site",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    {
      "pattern": "echo.algo-cli.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
